# ******************  NOTICE: ACTUAL PRODUCTION VALUES RESIDE ON RAILWAY  ******************
# This file documents every env var the website uses. Copy it to .env for local
# development and fill in real values. NEVER commit .env itself.
#
# Locally, only DATABASE_URL is needed. The rest exist on Railway and are listed
# here so nothing is a mystery.


# DATABASE URL (required)
# Postgres connection string for the CHLM Dashboard's database. This site only
# READS from it; the dashboard repo owns the schema and its migrations.
#
#   Local:   the Dev-Database (sandbox) DATABASE_PUBLIC_URL, the same database
#            your local dashboard uses. Must be a public *.proxy.rlwy.net URL:
#            *.railway.internal hosts only resolve inside Railway.
#   Railway: the production database.
#
# NEVER run `prisma migrate` or `prisma db push` from this repo, against any
# database. See the warning at the top of prisma/schema.prisma.
DATABASE_URL=


# PUBLIC SITE ORIGIN (Railway only; leave unset locally)
# Public URL for canonical tags, Open Graph, robots.txt and sitemap.xml, and the
# host that www / *.up.railway.app requests 301-redirect to (src/entry.express.tsx).
# No trailing slash. BUILD-TIME: changing it requires a redeploy.
# Defaults to the Railway URL when unset.
# PUBLIC_SITE_ORIGIN=https://chlandscapematerials.com


# ORIGIN (Railway only; leave unset locally)
# Read by Qwik City's Node middleware as the site's own origin. Behind Railway's
# proxy it can't reliably work this out from the request, so set it to the same
# value as PUBLIC_SITE_ORIGIN. Not needed for `pnpm dev`.
# ORIGIN=https://chlandscapematerials.com


# PORT (Railway sets this automatically; leave unset locally)
# Port for the production Express server (`pnpm start`). Defaults to 3000.
# PORT=3000


# CACHE_BUST (Railway only)
# Not read by the app code. Exists only on Railway, where changing a variable's
# value triggers a fresh deploy.
# CACHE_BUST=
